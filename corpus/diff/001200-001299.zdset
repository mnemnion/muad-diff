zΔ⚡b|=db|-21|=1e|-9|=c5|-1|=283|-21|=3|+[[|=9|+]]|=1e|+[[|=f|+]]|=57|+[[|=d|+]]|=67|+[[|=14|+]]|=ff|+[[patch (Unix)%7C|=8|-1|=2|-7|+.|=2|-21|=7b|+[[|=b|+]]|=2|-2|=11|-1|+e|=d7|-2|=92|-1b|=24|+[[|=5|+ (computing)%7Cpatch]]|=2b|+[[|=4|+]]|=9|+[[patch (Unix)%7C|=e|+]]|=65|+[[|=4|+]]|=87|-2|=52|-2|=a1|-1b|=4|+[[|=5|+]]|=5c|-2|=17|-1|+1|=1f|-1|+2%2Dlink %3D The Open Group%7Cauthor2|=be|+1%2Dl|=2|-1|+k|=c1|-7|=217|-1|+1|=15|-1|+2|=23d|-5|+ECOS|=11|+k|=21c|-6|+DP%2D11|=a95|-3|+US|=177|-1|+c|=84c|-1|=4|-1|=1ff|-1|=4|-1|=25|-1|=4|-1|=24b|-1|=4|-1|=9d|+gre|=8a|-1|=66|-2|+17|=1|-2|+18|=12|-1|=35|-1|=3c|-1|=4f0|-1|+1|=17|-1|+2|=13|-1|+3|=22d|-4|+24''|=1|-1|+a|=5b|-5|+17'''|=34|-4|+0'''|=1a9|-2|=1|-1|+q|=9|-1|=31|-1|=5f|-1|=8a9|-1|=4|-1|=3bb|-1|=4|-1|=108|-2b|=e|-9|=5|-2b|=27|-2|=2ef|-25|=bf|+<code>|=2|+</code>|=2|+[[|=13|+]]|=2c|+[[|=5|+ (Unix)%7Cpatch]]|=b9|-9|=2|-2b|=95|+[[|=10|+]]|=23|+[[GNU%7C|=b|+]]|=c4|-9|=2|-2b|=29|+[[Header (computing)%7C|=6|+]]|=151|+[[|=9|+]]|=27|+[[|=a|-1|=2|-7|+.|=2|-2b|=c6|+[[|=7|+]]|=54|+[[#Context format%7C|=5|+]]|=3a|-9|=3|-2b|=2c|-35|=c|-1|=4|-1|=28|-9|=2|-2b|=269|-9|=2|-2b|=16d|-9|=2|-2b|=e7|+[[|=12|+]]|=a|-2|=98|-7|=2|-2b|=bd|-2|=81|-25|=2e|-9|=42|-3|+The c|=6|-5|=1|-16|=6|-c|=14|+</code>|=1f|-9|=8|-1|=4|-1|=2cb|-1|=4|-1|=7|-2b|=94|+[[|=a|+]]|=3f|+[[|=13|+]]|=3|-9|=2|-2b|=db|-9|=380|-2|=5f2|-3|+ND|=7e|-3|+ND|=107|-1|+1|=14|-1|+2|=227|-2|+o|=1|-1|+%2D|=2|-1|+c|=1|+s|=1cc|-2|=496|-2|+E|=407|+x|=11|-3|+XD|=c1|-1|+m|=1|+ay|=d8|-1|+d|=450|-1|+1|=f|-1|+1|=d|-1|+anda|=3|-1|=68|-1|+util|=72|-1|+1|=d|-1|+1|=d|-1|+wa|=9|-1|+util|=1c3|-1|+1|=e|-1|+1|=1d7|-1|+1|=b|-1|+1|=f3|-1|+Cd|=ba|-2|=6f|-3|+SmartD|=9|+r|=40|-2|=21a|-2|+d|=10|-3|+Di|=30|-2|=116|-2|=8d|+x|=1|-5|=2|+iffm|=2|+ge|=39|-2|=93|-1|+a|=2|-2|+ii|=ae|-2|=1a0|-1|+d|=2|+tc|=2|-4|+lme|=e|-1|+h|=1|-1|+u|=a|-4|+HPUX|=f2|-1|+a%2D2|=347|+nt|=1|-1|+all|=2|-1|+do|=1|-3|+c|=1|-1|+m|=121|-2|=10a|-1|+h|=1|-1|+u|=157|-1|=1|-2|+XD|=1|-2|+ff|=110|-1|=1|-2|+XD|=1|-2|+ff|=54|-2|+M|=1bf|-1|+1|=f|-1|+1|=22|-1|+2|