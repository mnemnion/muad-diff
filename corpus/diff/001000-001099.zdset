}}|=704|+ {{Webarchive%7Curl%3Dhttps://web.archive.org/web/20150316032418/http://www.gnu.org/software/diffutils/ %7Cdate%3D2015%2D03%2D16 }}|=5b|-1|=119|+ %7Caccess%2Ddate%3D28 June 2020 %7Carchive%2Ddate%3D1 October 2020 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20201001234609/https://github.com/twaugh/patchutils %7Curl%2Dstatus%3Dlive |=310|+%7Carchive%2Ddate%3D18 September 2019%7Carchive%2Durl%3Dhttps://web.archive.org/web/20190918125803/http://www.gnu.org/software/rcs/manual/html_node/merge.html%7Curl%2Dstatus%3Dlive|=339|+%7Carchive%2Ddate%3D16 February 2020%7Carchive%2Durl%3Dhttps://web.archive.org/web/20200216203940/https://vimhelp.org/diff.txt.html#vimdiff%7Curl%2Dstatus%3Dlive|=274|+%7Caccess%2Ddate%3D2020%2D09%2D12%7Carchive%2Ddate%3D2020%2D08%2D11%7Carchive%2Durl%3Dhttps://web.archive.org/web/20200811124535/https://www.gnu.org/software/wdiff/wdiff.html%7Curl%2Dstatus%3Dlive|=179|+%7Caccess%2Ddate%3D2018%2D06%2D14%7Carchive%2Ddate%3D2018%2D06%2D14%7Carchive%2Durl%3Dhttps://web.archive.org/web/20180614121429/https://www.colordiff.org/%7Curl%2Dstatus%3Dlive|=1ec|+%7Caccess%2Ddate%3D2017%2D11%2D01%7Carchive%2Ddate%3D2010%2D06%2D12%7Carchive%2Durl%3Dhttps://web.archive.org/web/20100612103752/http://www.cs.wisc.edu/wpis/papers/sigplan90.ps%7Curl%2Dstatus%3Dlive|=295|+ {{Webarchive%7Curl%3Dhttps://web.archive.org/web/20091014160445/http://www.semanticdesigns.com/Products/SmartDifferencer/ %7Cdate%3D2009%2D10%2D14 }}|=d8|+ %7Caccess%2Ddate%3D27 June 2020 %7Carchive%2Ddate%3D21 December 2020 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20201221105419/https://github.com/xaizek/zograscope %7Curl%2Dstatus%3Dlive |=53|+ {{Webarchive%7Curl%3Dhttps://web.archive.org/web/20150319014218/http://code.google.com/p/daisydiff/ %7Cdate%3D2015%2D03%2D19 }}|=a2|+ {{Webarchive%7Curl%3Dhttps://web.archive.org/web/20091027123710/http://msdn.microsoft.com/en%2Dus/library/aa302294.aspx %7Cdate%3D2009%2D10%2D27 }}|=4c|+ {{Webarchive%7Curl%3Dhttps://web.archive.org/web/2009092403