zΔ⚡b|=e89|+Webarchive%7Curl%3Dhttps://web.archive.org/web/20220702061233/https://minnie.tuhs.org/cgi%2Dbin/utree.pl?file%3DV5/usr/source/s1/diff1.c %7Cdate%3D2022%2D07%2D02 }} {{|=52a6|+ %7Caccess%2Ddate%3D2023%2D06%2D15 %7Carchive%2Ddate%3D2023%2D05%2D08 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20230508092618/https://www.gnu.org/software/diffutils/manual/html_node/Incomplete%2DLines.html %7Curl%2Dstatus%3Dlive |=f7|+ %7Caccess%2Ddate%3D15 June 2023 %7Carchive%2Ddate%3D13 May 2023 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20230513063349/https://github.com/git/git/blob/69c786637d7a7fe3b2b8f7d989af095f5f49c3a8/apply.c#LL2901C35%2DL2901C39 %7Curl%2Dstatus%3Dlive |=206|+ %7Caccess%2Ddate%3D2023%2D06%2D15 %7Carchive%2Ddate%3D2023%2D05%2D08 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20230508094116/https://git.savannah.gnu.org/cgit/patch.git/tree/src/patch.c?id%3Dc835ecc67b7e37c0d0b7dd7e032209fdaa285808#n1919 %7Curl%2Dstatus%3Dlive |=14a3|+ %7Caccess%2Ddate%3D8 May 2023 %7Carchive%2Ddate%3D8 May 2023 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20230508093250/https://github.com/so%2Dfancy/diff%2Dso%2Dfancy %7Curl%2Dstatus%3Dlive |=f4|+ %7Caccess%2Ddate%3D8 May 2023 %7Carchive%2Ddate%3D8 May 2023 %7Carchive%2Durl%3Dhttps://web.archive.org/web/20230508093248/https://github.com/dandavison/delta %7Curl%2Dstatus%3Dlive |=254e|
